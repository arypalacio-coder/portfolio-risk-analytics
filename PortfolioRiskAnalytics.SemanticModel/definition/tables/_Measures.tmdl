	measure 'Portfolio Daily Drawdown' = ```
			
			VAR _CurrentDate = MAX(dim_date[date_key])
			VAR _PortfolioToDate = 
			    CALCULATETABLE(
			        SUMMARIZE(
			            fct_daily_positions,
			            fct_daily_positions[date_key],
			            "@NAV", SUM(fct_daily_positions[market_value])
			        ),
			        fct_daily_positions[date_key] <= _CurrentDate,
			        REMOVEFILTERS(dim_date)
			    )
			VAR _CurrentNAV = 
			    CALCULATE(
			        SUM(fct_daily_positions[market_value]),
			        fct_daily_positions[date_key] = _CurrentDate
			    )
			VAR _PeakNAV = MAXX(_PortfolioToDate, [@NAV])
			RETURN
			    IF(
			        NOT ISBLANK(_CurrentNAV) && _PeakNAV > 0,
			        DIVIDE(_CurrentNAV - _PeakNAV, _PeakNAV),
			        BLANK()
			    )
			```
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: 3c8a9843-4799-4d1f-9200-39e8a9d9f882

	measure 'Asset Beta' = ```
			
			VAR _BenchmarkKey = 1 -- SPY
			VAR _AssetKey = SELECTEDVALUE(dim_asset[asset_key])
			VAR _AssetReturns = 
			    CALCULATETABLE(
			        SELECTCOLUMNS(
			            fct_asset_prices,
			            "DateKey", fct_asset_prices[date_key],
			            "ReturnAsset", fct_asset_prices[return_1d]
			        ),
			        fct_asset_prices[asset_key] = _AssetKey,
			        REMOVEFILTERS(dim_asset)
			    )
			VAR _BenchmarkReturns = 
			    CALCULATETABLE(
			        SELECTCOLUMNS(
			            fct_asset_prices,
			            "DateKey", fct_asset_prices[date_key],
			            "ReturnBench", fct_asset_prices[return_1d]
			        ),
			        fct_asset_prices[asset_key] = _BenchmarkKey,
			        REMOVEFILTERS(dim_asset)
			    )
			VAR _JoinedReturns = 
			    NATURALINNERJOIN(_AssetReturns, _BenchmarkReturns)
			VAR _AvgAsset = AVERAGEX(_JoinedReturns, [ReturnAsset])
			VAR _AvgBench = AVERAGEX(_JoinedReturns, [ReturnBench])
			VAR _Covariance = 
			    SUMX(
			        _JoinedReturns,
			        ([ReturnAsset] - _AvgAsset) * ([ReturnBench] - _AvgBench)
			    )
			VAR _BenchVariance = 
			    SUMX(
			        _JoinedReturns,
			        ([ReturnBench] - _AvgBench) * ([ReturnBench] - _AvgBench)
			    )
			RETURN
			    IF(
			        _BenchVariance > 0,
			        DIVIDE(_Covariance, _BenchVariance),
			        BLANK()
			    )
			```
		formatString: 0.00
		lineageTag: 593cf953-da5a-4cd9-ab61-599aef6d3c80

	measure 'Asset Alpha' = ```
			
			VAR _BenchmarkKey = 1 -- SPY
			VAR _BenchmarkDailyReturns = 
			    CALCULATETABLE(
			        SELECTCOLUMNS(
			            fct_asset_prices,
			            "DateKey", fct_asset_prices[date_key],
			            "BenchReturn", fct_asset_prices[return_1d]
			        ),
			        fct_asset_prices[asset_key] = _BenchmarkKey,
			        REMOVEFILTERS(dim_asset)
			    )
			VAR _BenchAvgReturn = AVERAGEX(_BenchmarkDailyReturns, [BenchReturn])
			VAR _BenchAnnualized = _BenchAvgReturn * 252
			VAR _AssetReturn = [Asset Return Annualized]
			VAR _Beta = [Asset Beta]
			RETURN
			    IF(
			        NOT ISBLANK(_Beta) && NOT ISBLANK(_AssetReturn),
			        _AssetReturn - (_Beta * _BenchAnnualized),
			        BLANK()
			    )
			```
		formatString: 0.00\ %;-0.00\ %;0.00\ %
		lineageTag: 33f8c40d-774e-4802-bc26-2fd2da1979c2

	measure 'Sharpe Ratio' = ```
			
			VAR _DailyPortfolio = 
			    CALCULATETABLE(
			        SUMMARIZE(
			            fct_daily_positions,
			            fct_daily_positions[date_key],
			            "@NAV", SUM(fct_daily_positions[market_value])
			        ),
			        REMOVEFILTERS(dim_date),
			        REMOVEFILTERS(dim_asset)
			    )
			VAR _ValidDays = FILTER(_DailyPortfolio, [@NAV] > 0)
			VAR _WithPrev = 
			    ADDCOLUMNS(
			        _ValidDays,
			        "@PrevDate", 
			            VAR _D = fct_daily_positions[date_key]
			            RETURN MAXX(FILTER(_ValidDays, fct_daily_positions[date_key] < _D), fct_daily_positions[date_key])
			    )
			VAR _ReturnsTable = 
			    ADDCOLUMNS(
			        FILTER(_WithPrev, NOT ISBLANK([@PrevDate])),
			        "@DailyRet",
			            VAR _PKey = [@PrevDate]
			            VAR _PNAV = MAXX(FILTER(_ValidDays, fct_daily_positions[date_key] = _PKey), [@NAV])
			            RETURN DIVIDE([@NAV] - _PNAV, _PNAV)
			    )
			VAR _MeanDaily = AVERAGEX(_ReturnsTable, [@DailyRet])
			VAR _StdDaily = STDEVX.S(_ReturnsTable, [@DailyRet])
			VAR _AnnualReturn = _MeanDaily * 252
			VAR _AnnualVol = _StdDaily * SQRT(252)
			VAR _Rf = 0.0
			RETURN
			    IF(
			        NOT ISBLANK(_AnnualVol) && _AnnualVol > 0,
			        DIVIDE(_AnnualReturn - _Rf, _AnnualVol),
			        BLANK()
			    )
			```
		lineageTag: 3cfdcd67-2931-4e1d-a4f6-9d4929994c72

		annotation PBI_FormatHint = {"isGeneralNumber":true}

