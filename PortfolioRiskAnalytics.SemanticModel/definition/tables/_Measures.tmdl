	measure 'Current Value' = ```
			
			VAR _MaxPosDate = 
			    CALCULATE(
			        MAX(fct_daily_positions[date_key]),
			        REMOVEFILTERS(dim_date)
			    )
			VAR _VisibleMaxDate = MAX(dim_date[date_key])
			VAR _TargetDate = 
			    IF(
			        ISBLANK(_VisibleMaxDate), 
			        _MaxPosDate, 
			        MIN(_VisibleMaxDate, _MaxPosDate)
			    )
			RETURN
			    CALCULATE(
			        SUM(fct_daily_positions[market_value]),
			        REMOVEFILTERS(dim_date),
			        fct_daily_positions[date_key] = _TargetDate
			    )
			```
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
